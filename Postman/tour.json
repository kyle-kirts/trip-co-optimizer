		{
			"name": "kyle-kirts: Validate Response Schema",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "206ecad7-dd29-44e5-b33e-e07d3cef0ef5",
						"exec": [
							"// Schema test template taken from Postman Documentation",
							"var schema = {",
							"  \"$id\": \"https://example.com/address.schema.json\",",
							"  \"$schema\": \"http://json-schema.org/draft-07/schema#\",",
							"  \"title\": \"tour\",",
							"  \"description\": \"tour request/response\",",
							"  \"type\": \"object\",",
							"  \"properties\": {",
							"    \"requestType\": {",
							"      \"description\":\"the TIP object type should be tour\",",
							"      \"type\":\"string\",",
							"      \"pattern\":\"^tour$\"",
							"    },",
							"    \"earthRadius\": {",
							"      \"description\":\"the radius of the earth in some unit of measure\",",
							"      \"type\":\"number\",",
							"      \"minimum\":1",
							"    },",
							"    \"response\": {",
							"      \"description\": \"the maximum response time\",",
							"      \"type\": \"number\",",
							"      \"minimum\": 0",
							"    },",
							"    \"formula\":{",
							"      \"description\":\"a formula included in the formulae property of the config response.\",",
							"      \"type\":\"string\",",
							"      \"minimum\":1",
							"    },",
							"    \"places\": {",
							"      \"description\": \"a list of places\",",
							"      \"type\":\"array\",",
							"      \"items\": {",
							"        \"type\":\"object\",",
							"        \"properties\": {",
							"          \"latitude\": {",
							"            \"type\":\"string\",",
							"            \"pattern\":\"^[-+]?(?:90(?:(?:\\\\.0+)?)|(?:[0-9]|[1-8][0-9])(?:(?:\\\\.[0-9]+)?))$\"",
							"          },",
							"          \"longitude\": {",
							"            \"type\":\"string\",",
							"            \"pattern\":\"^[-+]?(?:180(?:(?:\\\\.0+)?)|(?:[0-9]|[1-9][0-9]|1[0-7][0-9])(?:(?:\\\\.[0-9]+)?))$\"",
							"          }",
							"        },",
							"        \"required\": [\"latitude\",\"longitude\"],",
							"        \"additionalProperties\": { \"type\": \"string\" }",
							"      },",
							"      \"minitems\": 0",
							"    }",
							"  },",
							"  \"required\":[\"requestType\", \"earthRadius\", \"response\", \"places\"],",
							"  \"additionalProperties\": false",
							"};",
							"",
							"pm.test('Schema validation', () => {",
							"  pm.response.to.have.jsonSchema (schema);",
							"});",
							"",
							"var data = pm.response.json();",
							"",
							"pm.test('Schema is valid', function() {",
							"pm.expect(tv4.validate(data, schema)).to.be.true;",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
