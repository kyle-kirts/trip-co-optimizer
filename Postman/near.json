							"pm.test(\"Jsibold: Airports near are within distance limit\", function () {\r",
							"    let r = pm.response.json();\r",
							"    pm.expect(r.requestType).to.eql(\"near\");\r",
							"    pm.expect(r.distance).to.be.within(1,50);\r",
							"    pm.expect(r.limit).to.eql(1);\r",
							"    pm.expect(r.place.latitude).to.match(/^-?\\d/);\r",
							"    pm.expect(r.place.longitude).to.match(/^-?\\d/);\r",
							"    pm.expect(r.places.length).to.be.at.most(1);\r",
							"});\r",
							""
