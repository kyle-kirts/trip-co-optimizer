			"name": "vercauteren: Airports fort collins has an airport",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "3e88712c-2bf5-4539-9ef2-30056e181a6b",
						"exec": [
							"pm.test(\"Fort collins has at least one, if not multiple airports.\", () => {",
							"    let len = pm.response.json().distances.length;",
							"    for(let i = 0; i<len; i++){",
							"        pm.expect(pm.response.json().places[i].municipality).to.include(\"Fort Collins\");",
							"    }",
							"});",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
