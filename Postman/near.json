		{
			"name": "kyle-kirts: Validate Response Schema",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "d4ac7df8-a43a-479e-a8ab-25c6fa611fdf",
						"exec": [
							"// Schema test template taken from Postman Documentation",
							"var schema = {",
							"  \"$id\": \"https://example.com/address.schema.json\",",
							"  \"$schema\": \"http://json-schema.org/draft-07/schema#\",",
							"  \"title\": \"near\",",
							"  \"description\": \"near request/response\",",
							"  \"type\": \"object\",",
							"  \"properties\": {",
							"    \"requestType\": {",
							"      \"description\":\"a request for known places near a specified place.\",",
							"      \"type\":\"string\",",
							"      \"pattern\":\"^near$\"",
							"    },",
							"    \"place\": {",
							"      \"description\":\"a place object containing geographic coordinates.\",",
							"      \"type\":\"object\",",
							"        \"properties\": {",
							"          \"latitude\": {",
							"            \"type\":\"string\",",
							"            \"pattern\":\"^[-+]?(?:90(?:(?:\\\\.0+)?)|(?:[0-9]|[1-8][0-9])(?:(?:\\\\.[0-9]+)?))$\"",
							"          },",
							"          \"longitude\": {",
							"            \"type\":\"string\",",
							"            \"pattern\":\"^[-+]?(?:180(?:(?:\\\\.0+)?)|(?:[0-9]|[1-9][0-9]|1[0-7][0-9])(?:(?:\\\\.[0-9]+)?))$\"",
							"          }",
							"        },",
							"        \"required\": [\"latitude\",\"longitude\"],",
							"        \"additionalProperties\": { \"type\": \"string\" }",
							"    },",
							"    \"distance\":{",
							"      \"description\":\"the maximum distance from place in earth radius units\",",
							"      \"type\":\"integer\",",
							"      \"minimum\":1,",
							"      \"maximum\":50",
							"    },",
							"    \"earthRadius\":{",
							"      \"description\":\"the radius of the earth in some unit of measure\",",
							"      \"type\":\"number\",",
							"      \"minimum\":1",
							"    },",
							"    \"formula\":{",
							"      \"description\":\"a formula included in the formulae property of the config response.\",",
							"      \"type\":\"string\"",
							"    },",
							"    \"source\":{",
							"      \"description\":\"a source included in the sources property of the config response.\",",
							"      \"type\":\"string\"",
							"    },",
							"    \"limit\": {",
							"      \"description\":\"the maximum number of matching places that may be returned.\",",
							"      \"type\":\"integer\",",
							"      \"minimum\":1",
							"    },",
							"    \"places\": {",
							"      \"description\": \"a list of places\",",
							"      \"type\":\"array\",",
							"      \"items\": {",
							"        \"type\":\"object\",",
							"        \"properties\": {",
							"          \"latitude\": {",
							"            \"type\":\"string\",",
							"            \"pattern\":\"^[-+]?(?:90(?:(?:\\\\.0+)?)|(?:[0-9]|[1-8][0-9])(?:(?:\\\\.[0-9]+)?))$\"",
							"          },",
							"          \"longitude\": {",
							"            \"type\":\"string\",",
							"            \"pattern\":\"^[-+]?(?:180(?:(?:\\\\.0+)?)|(?:[0-9]|[1-9][0-9]|1[0-7][0-9])(?:(?:\\\\.[0-9]+)?))$\"",
							"          },",
							"          \"municipality\": {",
							"            \"type\":\"string\"",
							"          },",
							"          \"region\": {",
							"            \"type\":\"string\"",
							"          },",
							"          \"country\": {",
							"            \"type\":\"string\"",
							"          }",
							"        },",
							"        \"required\": [\"latitude\",\"longitude\",\"municipality\",\"region\",\"country\"],",
							"        \"additionalProperties\": { \"type\": \"string\" }",
							"      },",
							"      \"minitems\": 0",
							"    },",
							"    \"distances\":{",
							"      \"description\":\"the great circle distance between the specified place and the items in the places list\",",
							"      \"type\":\"array\",",
							"      \"items\": {",
							"        \"type\":\"integer\",",
							"        \"minimum\": 0",
							"      },",
							"      \"minItems\": 0",
							"    }",
							"  },",
							"  \"required\":[\"requestType\", \"place\", \"distance\", \"earthRadius\", \"limit\", \"places\", \"distances\"],",
							"  \"additionalProperties\": false",
							"}",
							"",
							"pm.test('Schema validation', () => {",
							"  pm.response.to.have.jsonSchema (schema);",
							"});",
							"",
							"var data = pm.response.json();",
							"",
							"pm.test('Schema is valid', function() {",
							"pm.expect(tv4.validate(data, schema)).to.be.true;",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
